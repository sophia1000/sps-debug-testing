# Solid single-mesh debug panel for Unity.
# Size: 1x1x0.01, centered on origin, main faces lie parallel to the XY plane.
# The -Z face matches Unity's built-in Quad orientation.
# The +Z face has flipped U coordinates so panel text reads upright from behind.

o SpsDebugUprightSolidPanel

# Front face, -Z
v -0.500000 -0.500000 -0.005000
v  0.500000 -0.500000 -0.005000
v  0.500000  0.500000 -0.005000
v -0.500000  0.500000 -0.005000

# Back face, +Z
v -0.500000 -0.500000  0.005000
v  0.500000 -0.500000  0.005000
v  0.500000  0.500000  0.005000
v -0.500000  0.500000  0.005000

# Left edge
v -0.500000 -0.500000  0.005000
v -0.500000 -0.500000 -0.005000
v -0.500000  0.500000 -0.005000
v -0.500000  0.500000  0.005000

# Right edge
v  0.500000 -0.500000 -0.005000
v  0.500000 -0.500000  0.005000
v  0.500000  0.500000  0.005000
v  0.500000  0.500000 -0.005000

# Top edge
v -0.500000  0.500000 -0.005000
v  0.500000  0.500000 -0.005000
v  0.500000  0.500000  0.005000
v -0.500000  0.500000  0.005000

# Bottom edge
v -0.500000 -0.500000  0.005000
v  0.500000 -0.500000  0.005000
v  0.500000 -0.500000 -0.005000
v -0.500000 -0.500000 -0.005000

# Front UVs, U flipped to match the desired panel orientation.
vt 1.000000 0.000000
vt 0.000000 0.000000
vt 0.000000 1.000000
vt 1.000000 1.000000

# Back UVs, opposite face orientation also flipped.
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000

# Edge UVs use border strips to avoid visible stretched panel text.
vt 0.000000 0.000000
vt 0.000000 0.000000
vt 0.000000 1.000000
vt 0.000000 1.000000
vt 1.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 1.000000 1.000000
vt 0.000000 1.000000
vt 1.000000 1.000000
vt 1.000000 1.000000
vt 0.000000 1.000000
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 0.000000
vt 0.000000 0.000000

vn  0.000000  0.000000 -1.000000
vn  0.000000  0.000000  1.000000
vn -1.000000  0.000000  0.000000
vn  1.000000  0.000000  0.000000
vn  0.000000  1.000000  0.000000
vn  0.000000 -1.000000  0.000000

g SolidPanel
f 1/1/1 4/4/1 3/3/1 2/2/1
f 5/5/2 6/6/2 7/7/2 8/8/2
f 9/9/3 10/10/3 11/11/3 12/12/3
f 13/13/4 14/14/4 15/15/4 16/16/4
f 17/17/5 18/18/5 19/19/5 20/20/5
f 21/21/6 22/22/6 23/23/6 24/24/6
